<%- include('../partials/header') %>

<div class="app-container">
    <%- include('../partials/sidebar') %>

    <div class="app-main">
        <%- include('../partials/navbar') %>

        <div class="page-body-container">
            <%- include('../partials/alerts') %>

            <!-- Page Header -->
            <div class="page-header-banner">
                <div>
                    <h1 class="page-title">Edit Book Details</h1>
                    <div class="page-subtitle">Update catalog record for "<%= book.title %>"</div>
                </div>
                <div>
                    <a href="/books/<%= book._id %>" class="btn btn-outline-secondary">
                        <i class="fa-solid fa-arrow-left me-1"></i> Back to Details
                    </a>
                </div>
            </div>

            <div class="imrd-card">
                <div class="imrd-card-header">
                    <h2 class="imrd-card-title">
                        <i class="fa-solid fa-pen-to-square text-primary"></i>
                        <span>Modify Book Record</span>
                    </h2>
                    <span class="call-badge"><%= book.callNumber %></span>
                </div>
                <div class="imrd-card-body">
                    <form action="/books/<%= book._id %>/edit" method="POST">
                        <div class="row g-3">
                            <div class="col-md-8">
                                <label class="form-label">Book Title <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="title" value="<%= book.title %>" required>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Call Number <span class="text-danger">*</span></label>
                                <input type="text" class="form-control font-monospace" name="callNumber" value="<%= book.callNumber %>" required>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Author(s) <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="author" value="<%= book.author %>" required>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">ISBN <span class="text-danger">*</span></label>
                                <input type="text" class="form-control font-monospace" name="isbn" value="<%= book.isbn %>" required>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Category <span class="text-danger">*</span></label>
                                <select class="form-select" name="category" required>
                                    <% categories.forEach(cat => { %>
                                        <option value="<%= cat %>" <%= book.category === cat ? 'selected' : '' %>><%= cat %></option>
                                    <% }) %>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Publisher</label>
                                <input type="text" class="form-control" name="publisher" value="<%= book.publisher %>">
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Edition</label>
                                <input type="text" class="form-control" name="edition" value="<%= book.edition %>">
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Publication Year</label>
                                <input type="number" class="form-control" name="publishYear" value="<%= book.publishYear %>">
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Total Copies</label>
                                <input type="number" class="form-control" name="totalCopies" min="1" value="<%= book.totalCopies %>" required>
                                <small class="text-muted">Currently issued: <%= book.totalCopies - book.availableCopies %></small>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Price (INR)</label>
                                <div class="input-group">
                                    <span class="input-group-text">₹</span>
                                    <input type="number" class="form-control" name="price" value="<%= book.price %>">
                                </div>
                            </div>

                            <div class="col-md-12">
                                <label class="form-label">Rack Location <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="rackNumber" value="<%= book.rackNumber %>" required>
                            </div>

                            <div class="col-md-12">
                                <label class="form-label">Description / Remarks</label>
                                <textarea class="form-control" name="description" rows="3"><%= book.description %></textarea>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                            <span class="text-muted small">Updated: <%= new Date(book.updatedAt).toLocaleDateString('en-GB') %></span>
                            <div class="d-flex gap-2">
                                <a href="/books/<%= book._id %>" class="btn btn-outline-secondary">Cancel</a>
                                <button type="submit" class="btn btn-imrd-primary px-4">
                                    <i class="fa-solid fa-floppy-disk me-1"></i> Update Record
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <%- include('../partials/footer') %>
    </div>
</div>
