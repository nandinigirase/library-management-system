<%- include('../partials/header') %>

<div class="app-container">
    <%- include('../partials/sidebar') %>

    <div class="app-main">
        <%- include('../partials/navbar') %>

        <div class="page-body-container">
            <%- include('../partials/alerts') %>

            <!-- Page Header -->
            <div class="page-header-banner">
                <div>
                    <h1 class="page-title">Add New Book to Catalog</h1>
                    <div class="page-subtitle">Register academic titles into the Central Library inventory</div>
                </div>
                <div>
                    <a href="/books" class="btn btn-outline-secondary">
                        <i class="fa-solid fa-arrow-left me-1"></i> Back to Catalog
                    </a>
                </div>
            </div>

            <div class="imrd-card">
                <div class="imrd-card-header">
                    <h2 class="imrd-card-title">
                        <i class="fa-solid fa-book text-warning"></i>
                        <span>Book Details & Classification</span>
                    </h2>
                </div>
                <div class="imrd-card-body">
                    <form action="/books" method="POST">
                        <div class="row g-3">
                            <!-- Title -->
                            <div class="col-md-8">
                                <label class="form-label">Book Title <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="title" required placeholder="e.g. Database System Concepts">
                            </div>

                            <!-- Call Number -->
                            <div class="col-md-4">
                                <label class="form-label">Call Number / Shelf Code <span class="text-danger">*</span></label>
                                <input type="text" class="form-control font-monospace" name="callNumber" value="<%= suggestedCallNumber %>" required>
                                <small class="text-muted">Unique library shelf classification code</small>
                            </div>

                            <!-- Author -->
                            <div class="col-md-6">
                                <label class="form-label">Author(s) <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="author" required placeholder="e.g. Abraham Silberschatz, Henry F. Korth">
                            </div>

                            <!-- ISBN -->
                            <div class="col-md-6">
                                <label class="form-label">ISBN Number <span class="text-danger">*</span></label>
                                <input type="text" class="form-control font-monospace" name="isbn" required placeholder="e.g. 978-0078022159">
                            </div>

                            <!-- Category -->
                            <div class="col-md-6">
                                <label class="form-label">Academic Category / Subject <span class="text-danger">*</span></label>
                                <select class="form-select" name="category" required>
                                    <option value="" disabled selected>Select Category...</option>
                                    <% categories.forEach(cat => { %>
                                        <option value="<%= cat %>"><%= cat %></option>
                                    <% }) %>
                                </select>
                            </div>

                            <!-- Publisher -->
                            <div class="col-md-6">
                                <label class="form-label">Publisher</label>
                                <input type="text" class="form-control" name="publisher" placeholder="e.g. McGraw-Hill Education / Pearson">
                            </div>

                            <!-- Edition -->
                            <div class="col-md-3">
                                <label class="form-label">Edition</label>
                                <input type="text" class="form-control" name="edition" placeholder="e.g. 8th Edition" value="1st Edition">
                            </div>

                            <!-- Publish Year -->
                            <div class="col-md-3">
                                <label class="form-label">Publication Year</label>
                                <input type="number" class="form-control" name="publishYear" min="1950" max="2030" value="<%= new Date().getFullYear() %>">
                            </div>

                            <!-- Total Copies -->
                            <div class="col-md-3">
                                <label class="form-label">Total Copies Acquired <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" name="totalCopies" min="1" value="3" required>
                            </div>

                            <!-- Price -->
                            <div class="col-md-3">
                                <label class="form-label">Price per Copy (INR)</label>
                                <div class="input-group">
                                    <span class="input-group-text">₹</span>
                                    <input type="number" class="form-control" name="price" min="0" step="0.5" placeholder="500">
                                </div>
                            </div>

                            <!-- Rack Location -->
                            <div class="col-md-12">
                                <label class="form-label">Physical Rack / Shelf Location <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="rackNumber" placeholder="e.g. Rack CS-01, Shelf B (Computer Dept Stacks)" required>
                            </div>

                            <!-- Description -->
                            <div class="col-md-12">
                                <label class="form-label">Book Synopsis / Academic Remarks</label>
                                <textarea class="form-control" name="description" rows="3" placeholder="Brief topics, curriculum reference (MCA/MBA Syllabus), or notes..."></textarea>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a href="/books" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-imrd-gold px-4">
                                <i class="fa-solid fa-plus-circle me-1"></i> Register Book
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <%- include('../partials/footer') %>
    </div>
</div>
