<%- include('../partials/header') %>

<div class="app-container">
    <%- include('../partials/sidebar') %>

    <div class="app-main">
        <%- include('../partials/navbar') %>

        <div class="page-body-container">
            <%- include('../partials/alerts') %>

            <div class="page-header-banner">
                <div>
                    <h1 class="page-title">Register New Student</h1>
                    <div class="page-subtitle">Create a library member account and access profile</div>
                </div>
                <div>
                    <a href="/students" class="btn btn-outline-secondary">
                        <i class="fa-solid fa-arrow-left me-1"></i> Back to Members
                    </a>
                </div>
            </div>

            <div class="imrd-card">
                <div class="imrd-card-header">
                    <h2 class="imrd-card-title">
                        <i class="fa-solid fa-user-graduate text-primary"></i>
                        <span>Student Information</span>
                    </h2>
                </div>
                <div class="imrd-card-body">
                    <form action="/students" method="POST">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">Student ID <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="studentId" required>
                            </div>
                            <div class="col-md-8">
                                <label class="form-label">Full Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="fullName" required>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Email <span class="text-danger">*</span></label>
                                <input type="email" class="form-control" name="email" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Phone <span class="text-danger">*</span></label>
                                <input type="tel" class="form-control" name="phone" required>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Department <span class="text-danger">*</span></label>
                                <select class="form-select" name="department" required>
                                    <option value="" selected disabled>Select department</option>
                                    <% departments.forEach(dept => { %>
                                        <option value="<%= dept %>"><%= dept %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Academic Year <span class="text-danger">*</span></label>
                                <select class="form-select" name="academicYear" required>
                                    <option value="" selected disabled>Select year</option>
                                    <% academicYears.forEach(year => { %>
                                        <option value="<%= year %>"><%= year %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Max Allowed Books</label>
                                <input type="number" class="form-control" name="maxAllowedBooks" value="3" min="1" max="10">
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Gender</label>
                                <select class="form-select" name="gender">
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>
                            <div class="col-md-8">
                                <label class="form-label">Address</label>
                                <input type="text" class="form-control" name="address" placeholder="Residence / Campus address">
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a href="/students" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-imrd-primary px-4">
                                <i class="fa-solid fa-user-plus me-1"></i> Register Member
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <%- include('../partials/footer') %>
    </div>
</div>
