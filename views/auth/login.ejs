<%- include('../partials/header') %>

<div class="login-page-body">
    <div class="login-card-container">
        <!-- Academic Emblem -->
        <div class="login-crest-box">
            <i class="fa-solid fa-building-columns"></i>
        </div>

        <div class="text-center mb-4">
            <h1 class="h4 fw-bold text-dark mb-1">IMRD SHAHADA</h1>
            <p class="text-muted small fw-semibold text-uppercase tracking-wider mb-2">
                Central Knowledge Resource Center
            </p>
            <div class="badge bg-warning text-dark px-3 py-1 rounded-pill small">
                <i class="fa-solid fa-shield-halved me-1"></i> Librarian Portal
            </div>
        </div>

        <%- include('../partials/alerts') %>

        <!-- Login Form -->
        <form action="/login" method="POST" class="mt-3">
            <div class="mb-3">
                <label for="username" class="form-label">
                    <i class="fa-solid fa-user-shield me-1 text-secondary"></i> Username
                </label>
                <input type="text" class="form-control form-control-lg fs-6" id="username" name="username" placeholder="e.g. admin" required autofocus autocomplete="username">
            </div>

            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center">
                    <label for="password" class="form-label">
                        <i class="fa-solid fa-lock me-1 text-secondary"></i> Password
                    </label>
                </div>
                <input type="password" class="form-control form-control-lg fs-6" id="password" name="password" placeholder="••••••••" required autocomplete="current-password">
            </div>

            <button type="submit" class="btn btn-imrd-gold w-100 py-2 fs-6 fw-bold">
                <i class="fa-solid fa-arrow-right-to-bracket me-2"></i> Authenticate & Enter
            </button>
        </form>

        <!-- Quick Demo Credentials Callout -->
        <div class="mt-4 p-3 bg-light rounded-3 border small">
            <div class="fw-bold text-secondary mb-1">
                <i class="fa-solid fa-circle-info text-primary me-1"></i> Default Demo Credentials:
            </div>
            <div class="d-flex justify-content-between align-items-center font-monospace">
                <span>User: <strong>admin</strong></span>
                <span>Pass: <strong>admin123</strong></span>
            </div>
        </div>

        <div class="text-center mt-4 text-muted" style="font-size: 0.76rem;">
            Institute of Management Research & Development, Shahada<br>
            Affiliated to KBC North Maharashtra University, Jalgaon
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
